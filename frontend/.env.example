# Copy to `.env.local` for local dev, and set the same keys in your Vercel
# project settings for production. Never commit a filled-in .env file - the
# original project committed `.env.production` with real values straight
# into git (frontend/.env.production was tracked); that shouldn't happen
# even though these are NEXT_PUBLIC_* values baked into the client bundle.

# Salon / app branding shown in the UI
NEXT_PUBLIC_SALON_NAME=
NEXT_PUBLIC_APP_NAME=SalonFlow
NEXT_PUBLIC_APP_DESCRIPTION=Salon Management Made Simple

# Backend API base URL (FastAPI), e.g. http://localhost:8000/api/v1 locally
# or https://your-backend.onrender.com/api/v1 in production
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Only needed if you later add a direct-to-Supabase code path (currently
# unused - the frontend only talks to the FastAPI backend above).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
