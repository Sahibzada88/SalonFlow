# Copy this file to `.env` and fill in real values. Never commit `.env`.

# App
DEBUG=false
SALON_NAME=My Salon
SALON_DOMAIN=localhost

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
# Used for auth sign_up/sign_in only (see app/core/supabase_client.py's
# get_auth_client()). Falls back to SUPABASE_SERVICE_KEY if left blank, but
# filling it in is recommended - it's the correct privilege level for these
# calls and this key is safe to expose (it's the same one used client-side
# in a typical Supabase app).
SUPABASE_ANON_KEY=
# Used for every table/RPC query - bypasses RLS. Keep secret.
SUPABASE_SERVICE_KEY=

# CORS - comma-separated list of exact frontend origins allowed to call this
# API with credentials. Never use "*" here.
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Session cookie (the access token is set as an httpOnly cookie, not
# returned in the JSON body - see CHANGES.md). Leave unset to use sensible
# per-environment defaults (secure+none in production, insecure+lax when
# DEBUG=true for local http dev). Override explicitly if your setup needs
# something different (e.g. frontend and backend on the same domain).
COOKIE_SECURE=true
COOKIE_SAMESITE=none

# JWT - only needed if you later issue your own tokens instead of relying on
# Supabase Auth sessions. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Cloudinary (optional - image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo (optional - transactional email)
BREVO_API_KEY=
