{
  "services": [
    {
      "source": "frontend",
      "framework": "nextjs"
    },
    {
      "source": "backend",
      "framework": "fastapi",
      "entrypoint": "app/main.py:app"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "backend"
    },
    {
      "source": "/(.*)",
      "destination": "frontend"
    }
  ]
}